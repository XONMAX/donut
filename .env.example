# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
# Public origin, used for canonical URLs, sitemap.xml and CSRF Origin checks.
SITE_URL=http://localhost:3000
DB_PATH=data/app.db
# Number of trusted reverse proxies in front of the app (1 for Cloud Run / nginx / Cloudflare).
TRUST_PROXY=
# Long random string. Unlocks /admin. Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me

# ---------------------------------------------------------------------------
# DonutSMP official API — read-only (balances). Create a key in-game with /api.
# ---------------------------------------------------------------------------
DONUTSMP_API_KEY=

# ---------------------------------------------------------------------------
# In-game bank bot (pay-in / pay-out / account verification)
#   mock       – no Minecraft connection; simulate events from /admin (dev)
#   mineflayer – a real Minecraft account logged into DonutSMP
# ---------------------------------------------------------------------------
BRIDGE=mock
BOT_USERNAME=DropDuelBank
MC_HOST=donutsmp.net
MC_PORT=25565
MC_AUTH=microsoft
# Microsoft account email of the bot. First start prints a device-login code in /admin + logs.
MC_EMAIL=
MC_PROFILES_DIR=data/mc-auth
# MC_VERSION=1.21.4
# Chat formats (system messages only). Adjust if DonutSMP changes its wording.
# MC_PAY_REGEX=^(\.?[A-Za-z0-9_]{3,16}) paid you \$([0-9.,]+[KkMmBbTt]?)\.?$
# MC_PAID_REGEX=^You paid (\.?[A-Za-z0-9_]{3,16}) \$([0-9.,]+[KkMmBbTt]?)\.?$
# MC_WHISPER_REGEX=^\[?(\.?[A-Za-z0-9_]{3,16}) -> (?:me|you)\]? ?:? (.+)$
# MC_PAY_COMMAND=/pay {player} {amount}

# ---------------------------------------------------------------------------
# Limits (accept 1k / 2.5m / 1b shorthand) and payouts
# ---------------------------------------------------------------------------
MIN_BET=1
MAX_BET=50m
MIN_DEPOSIT=1
MIN_WITHDRAW=1k
WITHDRAW_REVIEW_AT=100m
DEPOSIT_REVIEW_AT=500m
DUEL_MULTIPLIER=1.95
COINFLIP_MULTIPLIER=1.96
